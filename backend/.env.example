# Copy to .env and fill in. Never commit .env.

# Postgres. Inside docker compose the host is `db`; running the backend on your
# machine against the compose database it is `localhost`.
DATABASE_URL=postgresql://app:app@localhost:5432/voiceagent

PORT=3000

# OpenAI — powers the chat channel (Phase 2c) and later the Realtime voice channel.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: override the chat model (default gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
